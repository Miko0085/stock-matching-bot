# RF (Moscow) Lead Matching Service — LOCAL SECRETS/CONFIG
# DO NOT COMMIT THIS FILE.

NODE_ENV=development

# ---------- Internal API ----------
RF_MATCHER_HOST=127.0.0.1
RF_MATCHER_PORT=8096
RF_MATCHER_API_KEY=

# ---------- PostgreSQL ----------
# Same physical Postgres instance as the UAE service is acceptable -- but
# this service must ONLY ever read/write matching_moscow.* (its own schema).
# It must never query matching_dubai.* (UAE contour tables).
DATABASE_URL=

# ---------- Versioning ----------
MATCHER_VERSION=rf-lead-matching-service-v1

# ---------- OpenAI (own key/model may be the same account as UAE's, but
# never share the runtime config object) ----------
RF_OPENAI_API_KEY=
RF_OPENAI_MODEL=gpt-4o-mini
RF_PARSER_VERSION=rf-lead-matching-service-parser-v1
RF_AI_CACHE_TTL_DAYS=14
RF_CONTENT_DEDUP_TTL_HOURS=48

# ---------- Telegram notifications (2026-09-29) ----------
# A SEPARATE bot from UAE's -- own token, one shared/general chat for now,
# no per-broker routing yet.
RF_TELEGRAM_NOTIFICATIONS_ENABLED=false
RF_TELEGRAM_BOT_TOKEN=
RF_TELEGRAM_MATCH_CHAT_ID=
RF_TELEGRAM_MAX_MESSAGE_LENGTH=3800

# ---------- Debug / logging ----------
LOG_LEVEL=info

# ---------- Test controls ----------
TEST_DATABASE_URL=
