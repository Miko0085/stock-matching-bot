# ---------- Server ----------
POCKET_LISTING_INGEST_HOST=127.0.0.1
POCKET_LISTING_INGEST_PORT=8098
POCKET_LISTING_INGEST_API_KEY=
# Alternative credential accepted alongside the API key: matches the
# X-Webhook-Secret header whatsapp-worker's WebhookDeliveryQueue sends to
# every monitored webhook target. Set this to the SAME value as
# whatsapp-worker's WA_MONITOR_WEBHOOK_SECRET if this service is listed as
# one of its WA_MONITOR_WEBHOOK_URL targets.
POCKET_LISTING_INGEST_WEBHOOK_SECRET=

# ---------- PostgreSQL (shared with the rest of the platform) ----------
DATABASE_URL=

# ---------- Source scope ----------
# Comma-separated WhatsApp group chat_ids this service actually reads.
# Everything else is ignored at the top of the webhook handler -- not
# logged, not dedup-tracked, nothing. Defaults to "Secondary Nika Estate"
# (wa_anna) if left empty.
POCKET_LISTING_SOURCE_CHAT_IDS=120363410119594257@g.us

# ---------- OpenAI ----------
# Falls back to OPENAI_API_KEY/OPENAI_MODEL if these are left empty -- set
# them explicitly only if this service needs its own key/model, same
# convention as every other matcher service in this repo.
POCKET_LISTING_OPENAI_API_KEY=
POCKET_LISTING_OPENAI_MODEL=gpt-4o-mini
POCKET_LISTING_PARSER_VERSION=pocket-listing-ingest-service-parser-v1

LOG_LEVEL=info
