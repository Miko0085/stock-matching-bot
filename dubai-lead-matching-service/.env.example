# Lead Matching Service — LOCAL SECRETS/CONFIG
# DO NOT COMMIT THIS FILE.

NODE_ENV=development

# ---------- Internal API ----------
# Bind to 127.0.0.1 by default -- this is an internal service, not meant to
# be reachable from the public internet directly.
MATCHER_HOST=127.0.0.1
MATCHER_PORT=8095
# Required in production. Workers/callers send it as `X-API-Key`.
MATCHER_API_KEY=
# Alternative credential accepted alongside MATCHER_API_KEY: matches the
# `X-Webhook-Secret` header telegram-worker's WebhookDeliveryQueue already
# sends to every n8n-style webhook target (its own TELEGRAM_MONITOR_WEBHOOK_SECRET).
# Set this to the SAME value as telegram-worker's TELEGRAM_MONITOR_WEBHOOK_SECRET if
# this service is listed as one of its TELEGRAM_MONITOR_WEBHOOK_URL targets.
MATCHER_WEBHOOK_SECRET=

# ---------- PostgreSQL ----------
# Same `matching` schema as nika-matching-pilot-starter -- no separate database.
DATABASE_URL=

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Matching configuration ----------
MATCH_PRICE_TOLERANCE_PCT=10
DEDUP_WINDOW_HOURS=48
STOCK_STALE_HOURS=36
MATCHER_VERSION=lead-matching-service-v1
PARSER_VERSION=lead-matching-service-v1

# How long a cached AI/local interpretation (matching_dubai.message_interpretation_cache,
# keyed by normalized-text hash + PARSER_VERSION above) is trusted before
# being treated as a miss. Bumping PARSER_VERSION invalidates the cache
# immediately regardless of this TTL.
INTERPRETATION_CACHE_TTL_DAYS=14

# ---------- Telegram notifications (added after v1, TZ 107-116) ----------
# Off by default -- a dev/test run must never accidentally message the
# real broker chat just because a token happens to be set below. Reuses
# the SAME bot token/chat the old n8n pilot used, on direct request.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MATCH_CHAT_ID=
TELEGRAM_MAX_MESSAGE_LENGTH=3800

# Qualified-buyer visibility (matching-correctness fix) -- both off by
# default. Enabling either starts a NEW message stream for genuine buyers
# whose outcome was NO_MATCH / INSUFFICIENT_CRITERIA (never a fake match).
# Uses the same TELEGRAM_BOT_TOKEN/TELEGRAM_MATCH_CHAT_ID above.
TELEGRAM_NOTIFY_QUALIFIED_NO_MATCH=false
TELEGRAM_NOTIFY_NEEDS_CRITERIA=false

# ---------- Debug / logging ----------
MATCH_DEBUG=false
LOG_LEVEL=info

# ---------- Test controls ----------
# Unit tests never call the real OpenAI API. Only scripts/replay-message.js
# and the live-tagged integration tests honor this flag.
RUN_OPENAI_LIVE_TESTS=false
TEST_DATABASE_URL=
