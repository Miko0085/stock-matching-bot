# Nika Estate Matching Pilot — LOCAL SECRETS/CONFIG
# DO NOT COMMIT THIS FILE.

# ---------- Environment ----------
NODE_ENV=development
PROJECT_NAME=Nika Estate Matching Pilot
APP_TIMEZONE=Asia/Dubai

# ---------- PostgreSQL ----------
# Prefer DATABASE_URL, or fill individual fields if deployment scripts support them.
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Existing source-message table; DO NOT change without inspecting current DB.
SOURCE_MESSAGES_TABLE=devi_messages

# ---------- n8n Public API ----------
N8N_BASE_URL=https://n8n.nikaestate.ae
N8N_API_URL=https://n8n.nikaestate.ae/api/v1
N8N_API_KEY=
N8N_ALLOW_WRITE=false
ALLOW_PRODUCTION_WORKFLOW_MUTATION=false

# Fill after pilot workflows are created.
N8N_STOCK_SYNC_WORKFLOW_ID=
N8N_MATCHING_WORKFLOW_ID=
# Existing production workflow ID only if explicitly needed for read-only diff / optional additive integration.
N8N_PRODUCTION_MONITORING_WORKFLOW_ID=

# Existing n8n credential IDs are optional. Secrets may also be embedded directly in workflow JSON.
N8N_POSTGRES_CREDENTIAL_ID=
N8N_GOOGLE_SHEETS_CREDENTIAL_ID=
N8N_OPENAI_CREDENTIAL_ID=
N8N_TELEGRAM_CREDENTIAL_ID=

# ---------- Google Sheets ----------
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_STOCK_TAB=Stock Inventory
GOOGLE_SHEETS_ALIASES_TAB=Aliases
GOOGLE_SHEETS_MATCH_LOG_TAB=Match Log

# ---------- OpenAI / AI parser ----------
# OpenAI may be configured here, via n8n Credentials, or embedded directly in workflow JSON.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_PARSER_VERSION=pilot-v1
RUN_LIVE_AI_TESTS=false

# ---------- Telegram matching alerts ----------
# Telegram may be configured here, via n8n Credentials, or embedded directly in workflow JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MATCH_CHAT_ID=
TELEGRAM_MAX_MESSAGE_LENGTH=3800
SEND_ALL_MATCHES_TO_TELEGRAM=true

# ---------- Matching configuration ----------
MATCH_ALLOWED_TRANSACTION_TYPES=SALE
MATCH_MIN_SCORE=70
MATCH_STRONG_SCORE=85
MATCH_PRICE_TOLERANCE_PCT=10
STOCK_STALE_HOURS=36
MATCHER_VERSION=pilot-v1

# Score weights — must total 100.
MATCH_WEIGHT_LOCATION=30
MATCH_WEIGHT_BEDROOMS=25
MATCH_WEIGHT_PROPERTY_TYPE=15
MATCH_WEIGHT_BUDGET=20
MATCH_WEIGHT_FURNISHING=10

# Budget partial-score bands.
MATCH_BUDGET_SCORE_WITHIN=20
MATCH_BUDGET_SCORE_OVER_0_TO_5=12
MATCH_BUDGET_SCORE_OVER_5_TO_10=5
MATCH_BUDGET_SCORE_OVER_10=0

# ---------- Stock sync ----------
# Daily sync time interpreted in APP_TIMEZONE.
STOCK_SYNC_HOUR=6
STOCK_SYNC_MINUTE=0

# ---------- Dashboard web page (read-only, matching.* views) ----------
DASHBOARD_PORT=8094
# Optional HTTP Basic Auth. Leave blank to run unauthenticated (only safe on
# an internal/private network) — set both to require login.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Telegram/WhatsApp worker status, shown read-only on the dashboard's
# /channels page. Same WORKER_API_KEY as telegram-worker/.env and
# whatsapp-worker/.env (both workers share one key in this deployment).
TELEGRAM_WORKER_URL=http://localhost:8091
WHATSAPP_WORKER_URL=http://localhost:8092
WORKER_API_KEY=

# ---------- Joker CRM (moscow.nikaestate.ru) ----------
JOKER_API_BASE_URL=https://moscow.nikaestate.ru/api
JOKER_API_TOKEN=

# ---------- Abu Dhabi Google Sheets stock sync ----------
# Abu Dhabi has no Joker feed (unlike Moscow/Oman/Saudi/Turkey above) --
# its stock/aliases sync from a dedicated Google Sheet instead, the same
# mechanism Dubai originally used (scripts/abu-dhabi-sheet-stock-sync-run.js).
# GOOGLE_SERVICE_ACCOUNT_JSON may be a path to the downloaded key file, or
# the key JSON itself -- never committed either way. The sheet must be
# shared with that service account's email (Viewer is enough).
GOOGLE_SERVICE_ACCOUNT_JSON=
ABU_DHABI_GOOGLE_SHEETS_SPREADSHEET_ID=
ABU_DHABI_GOOGLE_SHEETS_STOCK_TAB=Stock Inventory
ABU_DHABI_GOOGLE_SHEETS_ALIASES_TAB=Aliases
# Dry-run by default (AGENTS.md section 10's discipline) -- a real write
# needs BOTH this set to exactly "true" AND --write passed on the command line.
ABU_DHABI_SHEET_SYNC_ALLOW_WRITE=false

# ---------- Dubai pocket-listing stock import ----------
# scripts/dubai-pocket-stock-import-run.js -- a second Dubai stock source
# (a broker-provided .xlsx of off-market "pocket" listings), alongside the
# main sync. Dry-run by default; a real write needs BOTH this set to
# exactly "true" AND --write passed on the command line.
DUBAI_POCKET_STOCK_IMPORT_ALLOW_WRITE=false

# ---------- SSH tunnel to remote Postgres (devi_db) ----------
# Only connection metadata belongs here — the private key itself must live
# outside the repo (e.g. ~/.ssh/some_key), never pasted into this file.
# Start with: npm run tunnel
SSH_TUNNEL_HOST=
SSH_TUNNEL_USER=root
SSH_TUNNEL_KEY_PATH=
SSH_TUNNEL_LOCAL_PORT=55432
SSH_TUNNEL_REMOTE_PORT=5432

# ---------- Application server (deploy/restart lead-matching-service + dashboard) ----------
# See docs/OPERATIONS_ACCESS.md. Same "no key contents in this file" rule as the SSH tunnel above.
APP_SERVER_SSH_HOST=
APP_SERVER_SSH_USER=
APP_SERVER_SSH_KEY_PATH=
APP_SERVER_DEPLOY_PATH=
APP_SERVER_RESTART_CMD=
APP_SERVER_DASHBOARD_RESTART_CMD=

# ---------- Test controls ----------
RUN_N8N_INTEGRATION_TESTS=false
RUN_GOOGLE_SHEETS_LIVE_TESTS=false
RUN_TELEGRAM_LIVE_TESTS=false
TEST_DATABASE_URL=
