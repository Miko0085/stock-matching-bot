# Abu Dhabi Lead Matching Service — LOCAL SECRETS/CONFIG
# DO NOT COMMIT THIS FILE.

NODE_ENV=development

# ---------- Internal API ----------
ABU_DHABI_MATCHER_HOST=127.0.0.1
ABU_DHABI_MATCHER_PORT=8097
ABU_DHABI_MATCHER_API_KEY=

# ---------- PostgreSQL ----------
# Same physical Postgres instance as Dubai/RF is acceptable -- but this
# service must ONLY ever read/write matching_abu_dhabi.* (its own schema).
# It must never query matching_dubai.*/matching_moscow.* (other contours).
DATABASE_URL=

# ---------- Versioning ----------
MATCHER_VERSION=abu-dhabi-lead-matching-service-v1

# ---------- OpenAI (own key/model may be the same account as Dubai's, but
# never share the runtime config object) ----------
ABU_DHABI_OPENAI_API_KEY=
ABU_DHABI_OPENAI_MODEL=gpt-4o-mini
ABU_DHABI_PARSER_VERSION=abu-dhabi-lead-matching-service-parser-v1
ABU_DHABI_AI_CACHE_TTL_DAYS=14
ABU_DHABI_CONTENT_DEDUP_TTL_HOURS=48

# ---------- Telegram notifications ----------
# A SEPARATE bot from Dubai's/RF's -- own token, own chat.
ABU_DHABI_TELEGRAM_NOTIFICATIONS_ENABLED=false
ABU_DHABI_TELEGRAM_BOT_TOKEN=
ABU_DHABI_TELEGRAM_MATCH_CHAT_ID=
ABU_DHABI_TELEGRAM_MAX_MESSAGE_LENGTH=3800

# ---------- Debug / logging ----------
LOG_LEVEL=info

# ---------- Test controls ----------
TEST_DATABASE_URL=
